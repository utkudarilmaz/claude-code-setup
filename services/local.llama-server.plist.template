<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@SERVER_BIN@</string>
    <string>-m</string>
    <string>@MODEL_FILE@</string>
    <string>--alias</string>
    <string>@ALIAS@</string>
    <string>--host</string>
    <string>@HOST@</string>
    <string>--port</string>
    <string>@PORT@</string>
    <string>-c</string>
    <string>16384</string>
    <string>-ngl</string>
    <string>99</string>
    <string>--parallel</string>
    <string>1</string>
    <string>--jinja</string>
    <string>--reasoning</string>
    <string>off</string>
    <string>--temp</string>
    <string>0.3</string>
    <string>--top-k</string>
    <string>64</string>
    <string>--top-p</string>
    <string>0.95</string>
    <string>--spec-type</string>
    <string>draft-mtp,ngram-mod</string>
    <string>--spec-draft-model</string>
    <string>@MTP_FILE@</string>
    <string>--api-key-file</string>
    <string>@KEY_FILE@</string>
    <string>--sleep-idle-seconds</string>
    <string>@IDLE_SLEEP@</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@LOG_FILE@</string>
  <key>StandardErrorPath</key>
  <string>@LOG_FILE@</string>
</dict>
</plist>
